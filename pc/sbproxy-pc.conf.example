# sbproxy-pc.conf — configuration for update, backup, and restore scripts.
# Copy to sbproxy-pc.conf and edit it. Never commit or upload the real file.
#
# This file is optional because all values can be supplied on the command line.
# CLI arguments override the file. Select another file with --conf/-Conf or SBPC_CONF.
# Use simple KEY=value syntax without spaces around `=` for Bash/PowerShell compatibility.

# Router LAN IP address or hostname.
ROUTER_HOST=192.168.1.1
ROUTER_USER=root
ROUTER_PORT=22

# SSH private key path; leave empty for password/default-key authentication.
# Avoid spaces in the path.
SSH_KEY=

# Repository directory on the router.
REMOTE_DIR=/root/sbproxy

# Router backup directory; must match BACKUP_DIR in config/settings.sh.
REMOTE_BACKUP_DIR=/root/sbproxy-backups

# Local download directory; defaults to pc/backups when empty.
LOCAL_BACKUP_DIR=
