#!/bin/sh /etc/rc.common
# Chạy sbproxy-cloud-agent bằng procd (poll cloud server).
START=96
STOP=10
USE_PROCD=1

start_service() {
  procd_open_instance
  procd_set_param command /usr/sbin/sbproxy-cloud-agent
  procd_set_param respawn 3600 10 0
  procd_set_param stdout 1
  procd_set_param stderr 1
  procd_close_instance
}
