# wifi-socks.conf — single source of truth.
# One Wi-Fi per row, separated by `|`; do not add spaces around separators.
# Empty rows and rows beginning with `#` are ignored.
#
# Columns:
#   name     : Wi-Fi SSID; `|` is forbidden, internal spaces are allowed.
#   band     : 2g or 5g.
#   idx      : Unique positive integer. Determines subnet and TPROXY port.
#              subnet = 192.168.(NET_BASE+idx).0/24; keep deployed indexes stable.
#   wifi_key : Wi-Fi password, 8–63 characters for WPA2.
#   sock_host: Upstream SOCKS5 IP address or hostname.
#   sock_port: Upstream SOCKS5 port.
#   sock_user: SOCKS5 username; leave empty when authentication is disabled.
#   sock_pass: SOCKS5 password; leave empty when authentication is disabled.
#   isolate  : 1 blocks clients on the same Wi-Fi from reaching one another.
#   webrtc   : 1 blocks configured STUN/TURN ports to reduce WebRTC leaks.
#
# name|band|idx|wifi_key|sock_host|sock_port|sock_user|sock_pass|isolate|webrtc
Alpha|2g|1|Alpha_pass_123|1.2.3.4|1080|user1|pass1|1|1
Bravo|2g|2|Bravo_pass_123|5.6.7.8|1080|user2|pass2|1|1
Charlie|5g|3|Charlie_pass_123|9.9.9.9|1080|||1|0
