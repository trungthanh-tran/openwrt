# wifi-socks.conf — single source of truth.
# One Wi-Fi per row, separated by `|`; do not add spaces around separators.
# Empty rows and rows beginning with `#` are ignored.
#
# Columns:
#   name     : Wi-Fi SSID; `|` is forbidden, internal spaces are allowed.
#   band     : 2g or 5g.
#   idx      : Unique positive integer. Determines subnet and TPROXY port.
#              subnet = 192.168.(NET_BASE+idx).0/24; keep deployed indexes stable.
#   wifi_key : Wi-Fi password, 8–63 characters for WPA2.
#   proxy_host: Upstream proxy IP address or hostname.
#   proxy_port: Upstream proxy port.
#   proxy_user: Proxy username; leave empty when authentication is disabled.
#   proxy_pass: Proxy password; leave empty when authentication is disabled.
#   isolate  : 1 blocks clients on the same Wi-Fi from reaching one another.
#   webrtc   : 1 blocks configured STUN/TURN ports to reduce WebRTC leaks.
#   mac_oui  : OPTIONAL 11th column. 3-byte vendor prefix (AA:BB:CC) used as the
#              first half of the AP MAC; the last 3 bytes are randomized. Leave
#              empty (or omit the column) for a random locally-administered 02:
#              address. Common Wi-Fi vendor OUIs (also in the Console dropdown):
#                TP-Link 50:C7:BF · Netgear 20:E5:2A · ASUS AC:9E:17
#                Xiaomi 64:09:80 · Huawei 00:E0:FC · D-Link 1C:BD:B9
#                Linksys C0:56:27 · Tenda C8:3A:35 · Apple 3C:15:C2
#                Samsung 5C:0A:5B · Ubiquiti 24:A4:3C · Aruba 00:0B:86
#   proxy_type: OPTIONAL 12th column: socks5 (default for old rows) or http.
#
# name|band|idx|wifi_key|proxy_host|proxy_port|proxy_user|proxy_pass|isolate|webrtc|mac_oui|proxy_type
Alpha|2g|1|Alpha_pass_123|1.2.3.4|1080|user1|pass1|1|1|50:C7:BF|socks5
Bravo|2g|2|Bravo_pass_123|5.6.7.8|8080|user2|pass2|1|1|20:E5:2A|http
Charlie|5g|3|Charlie_pass_123|9.9.9.9|1080|||1|0||socks5
