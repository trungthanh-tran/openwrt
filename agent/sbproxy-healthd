#!/bin/sh
# sbproxy-healthd — probe each proxy endpoint and write latency JSON for the UI.
# Installed at /usr/sbin/sbproxy-healthd; runs under procd or once with --once.
#
# Output format in $HEALTH_FILE:
#   { "ts": 1699999999,
#     "probes": { "1": {"state":"ok","latency_ms":123,"code":204}, ... } }
# state: ok | slow | fail

if [ "${SBPROXY_SKIP_ENV:-0}" != "1" ] && [ -f /etc/sbproxy/env ]; then
  . /etc/sbproxy/env
fi
SB_ROOT="${SB_ROOT:-/root/sbproxy}"
CONF="${CONF:-$SB_ROOT/config/wifi-socks.conf}"
POOLS="${POOLS:-$SB_ROOT/config/proxy-pools.conf}"
HEALTH_FILE="${HEALTH_FILE:-/tmp/sbproxy-health.json}"
LOG_DIR="${LOG_DIR:-/etc/sbproxy/logs}"
HEALTH_LOG_STATE="${HEALTH_LOG_STATE:-/tmp/sbproxy-health-log-state}"
RUNTIME_ERROR_CURSOR="${RUNTIME_ERROR_CURSOR:-/tmp/sbproxy-health-error-cursor}"
LOG_RETENTION_DAYS="${LOG_RETENTION_DAYS:-7}"
case "$LOG_RETENTION_DAYS" in ''|*[!0-9]*|0) LOG_RETENTION_DAYS=7;; esac
PROBE_URL="${PROBE_URL:-https://www.gstatic.com/generate_204}"
PROBE_TIMEOUT="${PROBE_TIMEOUT:-8}"
INTERVAL="${INTERVAL:-15}"
SLOW_MS="${SLOW_MS:-800}"
HEALTHY_INTERVAL="${HEALTHY_INTERVAL:-300}"
SLOW_INTERVAL="${SLOW_INTERVAL:-120}"
FAIL_RETRY_BASE="${FAIL_RETRY_BASE:-15}"
FAIL_RETRY_MAX="${FAIL_RETRY_MAX:-300}"
MAX_POOL_PROBES_PER_RUN="${MAX_POOL_PROBES_PER_RUN:-4}"
for _n in HEALTHY_INTERVAL SLOW_INTERVAL FAIL_RETRY_BASE FAIL_RETRY_MAX MAX_POOL_PROBES_PER_RUN; do
  eval "_v=\${$_n}"
  case "$_v" in ''|*[!0-9]*|0) echo "healthd: $_n must be a positive integer" >&2; exit 1;; esac
done

command -v jq   >/dev/null 2>&1 || { echo "healthd: jq is missing";   exit 1; }
command -v curl >/dev/null 2>&1 || { echo "healthd: curl is missing"; exit 1; }

trim_field() { printf '%s' "$1" | sed 's/^[[:space:]]*//; s/[[:space:]]*$//'; }

health_daily_log() {
  mkdir -p "$LOG_DIR" 2>/dev/null || return 0
  chmod 700 "$LOG_DIR" 2>/dev/null || true
  _day="$(date +%Y-%m-%d)"
  ( umask 077; printf '%s health %s\n' "$(date '+%Y-%m-%d %H:%M:%S%z')" "$*" >> "$LOG_DIR/$_day.log" ) 2>/dev/null || true
}

purge_daily_logs() {
  mkdir -p "$LOG_DIR" 2>/dev/null || return 0
  _today="$(date +%Y-%m-%d)"; _marker="$LOG_DIR/.last-purge"
  [ "$(cat "$_marker" 2>/dev/null)" = "$_today" ] && return 0
  _max_age=$((LOG_RETENTION_DAYS - 1))
  find "$LOG_DIR" -type f -name '*.log' -mtime "+$_max_age" -exec rm -f {} \; 2>/dev/null || true
  ( umask 077; printf '%s\n' "$_today" > "$_marker" ) 2>/dev/null || true
}

# Replace every literal occurrence of $2 in $1 with ***. Never mask with sed:
# the password is data, but sed reads it as a regex and as part of the s|||
# command, so `|`, `[`, `&` or `;` in a real password broke the masking or
# leaked the cleartext. awk index() compares plain bytes only.
mask_secret() { # text secret -> masked text
  if [ -z "$2" ]; then printf '%s' "$1"; return; fi
  printf '%s' "$1" | S="$2" awk '
    { line = $0; masked = ""
      while ((i = index(line, ENVIRON["S"])) > 0) {
        masked = masked substr(line, 1, i - 1) "***"
        line = substr(line, i + length(ENVIRON["S"]))
      }
      print masked line }'
}

probe_one() {
  # Arguments: host port user pass type. Answers through globals so nothing
  # depends on a writable /tmp: PROBE_STATE PROBE_MS PROBE_CODE, plus
  # PROBE_ERROR — why the probe failed (curl exit + first stderr line, with
  # the credential blanked) so the UI shows *why* a proxy is red.
  host="$1"; port="$2"; user="$3"; pass="$4"; proxy_type="${5:-socks5}"
  [ "$proxy_type" = "http" ] && scheme="http" || scheme="socks5h"
  if [ -n "$user" ]; then px="$scheme://$user:$pass@$host:$port"; else px="$scheme://$host:$port"; fi
  PROBE_ERROR=""; PROBE_STATE=fail; PROBE_MS=0; PROBE_CODE=0
  # curl's stderr goes to a scratch file when one can be made; on a full or
  # read-only /tmp the probe still runs, only the error detail is lost.
  errf="${TMPDIR:-/tmp}/sbproxy-probe.$$"
  err=""
  if : > "$errf" 2>/dev/null; then
    # %{http_code} %{time_total}
    res="$(curl -sS -o /dev/null -m "$PROBE_TIMEOUT" -x "$px" \
           -w '%{http_code} %{time_total}' "$PROBE_URL" 2>"$errf")"; rc=$?
    err="$(head -n 1 "$errf" 2>/dev/null | tr -d '\r')"; rm -f "$errf"
    err="$(mask_secret "$err" "$pass")"
  else
    res="$(curl -sS -o /dev/null -m "$PROBE_TIMEOUT" -x "$px" \
           -w '%{http_code} %{time_total}' "$PROBE_URL" 2>/dev/null)"; rc=$?
  fi
  [ "$rc" -ne 0 ] && PROBE_ERROR="curl exit $rc${err:+: $err}"
  code="$(echo "$res" | awk '{print $1}')"
  t="$(echo "$res" | awk '{print $2}')"
  case "$code" in ''|*[!0-9]*) [ -n "$PROBE_ERROR" ] || PROBE_ERROR="no answer from curl"; return;; esac
  PROBE_CODE="$code"
  echo "$t" | grep -Eq '^[0-9]+([.][0-9]+)?$' || { [ -n "$PROBE_ERROR" ] || PROBE_ERROR="unreadable curl timing"; return; }
  ms="$(awk -v t="$t" 'BEGIN{printf "%d", (t*1000)+0.5}')"
  case "$code" in
    200|204|301|302)
      PROBE_MS="$ms"
      if [ "$ms" -gt "$SLOW_MS" ]; then PROBE_STATE=slow; else PROBE_STATE=ok; fi ;;
    *) [ -n "$PROBE_ERROR" ] || PROBE_ERROR="probe URL answered HTTP $code through the proxy" ;;
  esac
}

schedule_probe_result() { # endpoint previous-fail-count
  _spr_ep="$1"; _spr_fail="${2:-0}"
  case "$_spr_fail" in ''|*[!0-9]*) _spr_fail=0;; esac
  case "$PROBE_STATE" in
    ok)   _spr_fail=0; _spr_delay="$HEALTHY_INTERVAL" ;;
    slow) _spr_fail=0; _spr_delay="$SLOW_INTERVAL" ;;
    *)
      _spr_fail=$(( _spr_fail + 1 )); _spr_delay="$FAIL_RETRY_BASE"; _spr_i=1
      while [ "$_spr_i" -lt "$_spr_fail" ] && [ "$_spr_delay" -lt "$FAIL_RETRY_MAX" ]; do
        _spr_delay=$(( _spr_delay * 2 )); _spr_i=$(( _spr_i + 1 ))
      done
      [ "$_spr_delay" -le "$FAIL_RETRY_MAX" ] || _spr_delay="$FAIL_RETRY_MAX"
      ;;
  esac
  _spr_next=$(( now + _spr_delay ))
  PROBE_JSON="$(jq -n --arg st "$PROBE_STATE" --arg ep "$_spr_ep" --arg e "${PROBE_ERROR:-}" \
    --argjson ms "${PROBE_MS:-0}" --argjson c "${PROBE_CODE:-0}" --argjson checked "$now" \
    --argjson next "$_spr_next" --argjson fails "$_spr_fail" \
    '{state:$st,latency_ms:$ms,code:$c,endpoint:$ep,checked_at:$checked,next_check:$next,fail_count:$fails} + (if $e == "" then {} else {error:$e} end)')"
}

run_once() {
  [ -r "$CONF" ] || { echo "healthd: cannot read config $CONF" >&2; return 1; }
  purge_daily_logs
  now="$(date +%s)"
  case "$now" in ''|*[!0-9]*) now=0;; esac
  probes="{}"
  pool_probes="{}"
  old_probes="$(jq -c '.probes // {}' "$HEALTH_FILE" 2>/dev/null || printf '{}')"
  old_pool_probes="$(jq -c '.pool_probes // {}' "$HEALTH_FILE" 2>/dev/null || printf '{}')"
  runtime_bad=""
  if command -v logread >/dev/null 2>&1; then
    runtime_tmp="${TMPDIR:-/tmp}/sbproxy-health-errors.$$"
    logread 2>/dev/null | grep -E 'sing-box.*(ERROR|error).*out-w[0-9]+-s[0-9]+' > "$runtime_tmp" || true
    runtime_count="$(wc -l < "$runtime_tmp" | tr -d ' ')"
    runtime_seen="$(cat "$RUNTIME_ERROR_CURSOR" 2>/dev/null || printf '0')"
    case "$runtime_seen" in ''|*[!0-9]*) runtime_seen=0;; esac
    case "$runtime_count" in ''|*[!0-9]*) runtime_count=0;; esac
    [ "$runtime_count" -ge "$runtime_seen" ] || runtime_seen=0
    if [ "$runtime_count" -gt "$runtime_seen" ]; then
      runtime_bad="$(sed -n "$(( runtime_seen + 1 )),${runtime_count}p" "$runtime_tmp" 2>/dev/null \
        | sed -n 's/.*out-w\([0-9][0-9]*\)-s\([0-9][0-9]*\).*/\1|\2/p' | sort -u)"
    fi
    printf '%s\n' "$runtime_count" > "$RUNTIME_ERROR_CURSOR" 2>/dev/null || true
    rm -f "$runtime_tmp"
  fi
  state_tmp="$HEALTH_LOG_STATE.tmp.$$"
  : > "$state_tmp" 2>/dev/null || state_tmp=""
  # Read the source configuration.
  while IFS='|' read -r name band idx wifi_key host port user pass isolate webrtc _oui proxy_type extra; do
    case "$name" in ''|\#*) continue;; esac
    [ -z "$extra" ] || continue
    proxy_type="$(trim_field "${proxy_type:-socks5}")"
    case "$proxy_type" in socks5|http) :;; *) continue;; esac
    band="$(trim_field "$band")"
    isolate="$(trim_field "$isolate")"; webrtc="$(trim_field "$webrtc")"
    case "$band" in 2g|5g) :;; *) continue;; esac
    case "$isolate" in 0|1) :;; *) continue;; esac
    # webrtc: 0 keep, 1 block STUN/TURN, 2 bypass through the proxy IP.
    case "$webrtc" in 0|1|2) :;; *) continue;; esac
    [ "${#name}" -ge 1 ] && [ "${#name}" -le 32 ] || continue
    [ "${#wifi_key}" -ge 8 ] && [ "${#wifi_key}" -le 63 ] || continue
    idx="$(trim_field "$idx")"
    case "$idx" in ''|*[!0-9]*) continue;; esac
    [ "$idx" -ge 1 ] 2>/dev/null && [ "$idx" -le 200 ] 2>/dev/null || continue
    host="$(trim_field "$host")"; port="$(trim_field "$port")"
    case "$host" in ''|*[!A-Za-z0-9._:-]*) continue;; esac
    [ "${#host}" -le 253 ] || continue
    case "$port" in ''|*[!0-9]*) continue;; esac
    [ "$port" -ge 1 ] 2>/dev/null && [ "$port" -le 65535 ] 2>/dev/null || continue
    [ "${#user}" -le 255 ] && [ "${#pass}" -le 255 ] || continue
    # probe_one answers through globals — no subshell, no temp file, so the
    # result and PROBE_ERROR stay bound to THIS proxy even when /tmp is full.
    ep="$host:$port"
    previous_json="$(printf '%s' "$old_probes" | jq -c --arg i "$idx" '.[$i] // {}')"
    previous_ep="$(printf '%s' "$previous_json" | jq -r '.endpoint // ""')"
    previous_next="$(printf '%s' "$previous_json" | jq -r '.next_check // 0')"
    case "$previous_next" in ''|*[!0-9]*) previous_next=0;; esac
    if [ "$previous_ep" = "$ep" ] && [ "$previous_next" -gt "$now" ]; then
      PROBE_JSON="$previous_json"
    else
      previous_fail="$(printf '%s' "$previous_json" | jq -r '.fail_count // 0')"
      probe_one "$host" "$port" "$user" "$pass" "$proxy_type"
      schedule_probe_result "$ep" "$previous_fail"
    fi
    state="$(printf '%s' "$PROBE_JSON" | jq -r '.state // "pending"')"
    ms="$(printf '%s' "$PROBE_JSON" | jq -r '.latency_ms // 0')"
    code="$(printf '%s' "$PROBE_JSON" | jq -r '.code // 0')"
    previous="$(awk -v i="$idx" '$1 == i {print $2; exit}' "$HEALTH_LOG_STATE" 2>/dev/null)"
    if [ "$state" != "$previous" ]; then
      health_daily_log "idx=$idx endpoint=$host:$port state=$state latency_ms=$ms code=$code"
    fi
    [ -z "$state_tmp" ] || printf '%s %s\n' "$idx" "$state" >> "$state_tmp"
    # The endpoint travels with the result: "fail" on its own hid the whole
     # point of these lines, which is WHICH proxy did not answer.
    probes="$(printf '%s' "$probes" | jq --arg i "$idx" --argjson result "$PROBE_JSON" '.[$i] = $result')"
  done < "$CONF"

  # Probe every pool slot as well as each SSID's default proxy.  Pool slots are
  # what the DHCP assigner actually chooses, so a healthy SSID-level probe is
  # not enough to prevent a dead slot from being selected.
  if [ -r "$POOLS" ]; then
    pool_probe_count=0
    pool_tmp="${TMPDIR:-/tmp}/sbproxy-health-pool.$$"
    awk -F'|' '{ sub(/\r$/, ""); if ($0 ~ /^[[:space:]]*#/ || $0 ~ /^[[:space:]]*$/ || NF < 6 || NF > 7) next; i=$1; printf "%s|%d|%s|%s|%s|%s|%s|%s\n", i, seen[i]++, $2, $3, $4, $5, $6, (NF >= 7 ? $7 : "") }' "$POOLS" > "$pool_tmp" 2>/dev/null || :
    while IFS='|' read -r pidx pslot ptype phost pport puser ppass plabel pextra; do
      case "$pidx" in ''|\#*) continue;; esac
      [ -z "$pextra" ] || continue
      case "$ptype" in socks5|http) :;; *) continue;; esac
      pidx="$(trim_field "$pidx")"; phost="$(trim_field "$phost")"; pport="$(trim_field "$pport")"
      case "$pidx" in ''|*[!0-9]*) continue;; esac
      case "$pport" in ''|*[!0-9]*) continue;; esac
      [ "$pport" -ge 1 ] 2>/dev/null && [ "$pport" -le 65535 ] 2>/dev/null || continue
      [ "${#puser}" -le 255 ] && [ "${#ppass}" -le 255 ] || continue
      case "$pslot" in ''|*[!0-9]*) continue;; esac
      pep="$phost:$pport"
      previous="$(printf '%s' "$old_pool_probes" | jq -c --arg i "$pidx" --arg s "$pslot" '.[$i][$s] // {}')"
      previous_ep="$(printf '%s' "$previous" | jq -r '.endpoint // ""')"
      previous_next="$(printf '%s' "$previous" | jq -r '.next_check // 0')"
      case "$previous_next" in ''|*[!0-9]*) previous_next=0;; esac
      if printf '%s\n' "$runtime_bad" | grep -qx "$pidx|$pslot"; then
        previous_next=0
        health_daily_log "idx=$pidx slot=$pslot endpoint=$pep runtime-error=reprobe"
      fi
      if [ "$previous_ep" = "$pep" ] && [ "$previous_next" -gt "$now" ]; then
        PROBE_JSON="$previous"
      elif [ "$pool_probe_count" -ge "$MAX_POOL_PROBES_PER_RUN" ]; then
        PROBE_JSON="$previous"
        [ "$PROBE_JSON" != "{}" ] || PROBE_JSON="$(jq -n --arg ep "$pep" '{state:"pending",latency_ms:0,code:0,endpoint:$ep}')"
      else
        previous_fail="$(printf '%s' "$previous" | jq -r '.fail_count // 0')"
        probe_one "$phost" "$pport" "$puser" "$ppass" "$ptype"
        schedule_probe_result "$pep" "$previous_fail"
        pool_probe_count=$(( pool_probe_count + 1 ))
      fi
      pool_probes="$(printf '%s' "$pool_probes" | jq --arg i "$pidx" --arg s "$pslot" --argjson result "$PROBE_JSON" \
        '.[$i] = (.[$i] // {}) | .[$i][$s] = $result')"
    done < "$pool_tmp"
    rm -f "$pool_tmp"
  fi

  [ -z "$state_tmp" ] || mv "$state_tmp" "$HEALTH_LOG_STATE" 2>/dev/null || true

  ts="$now"
  tmp="$HEALTH_FILE.tmp.$$"
  jq -n --argjson ts "$ts" --argjson p "$probes" --argjson pp "$pool_probes" \
    '{ts:$ts, probes:$p, pool_probes:$pp}' > "$tmp" && mv "$tmp" "$HEALTH_FILE"
}

if [ "${1:-}" = "--once" ]; then run_once; exit $?; fi

# daemon loop
while :; do
  [ -f "$CONF" ] && run_once
  sleep "$INTERVAL"
done
