#!/bin/sh /etc/rc.common
# Run the proxy-pool safety-net daemon under procd.
#
# Starts after sbproxy (START=90) so the nftables table exists before the first
# sweep tries to sync a map against it.
START=96
STOP=10
USE_PROCD=1

start_service() {
  procd_open_instance
  procd_set_param command /usr/sbin/sbproxy-assignd
  procd_set_param respawn 3600 5 0
  procd_set_param stdout 1
  procd_set_param stderr 1
  procd_close_instance
}
