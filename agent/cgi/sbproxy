#!/bin/sh
# sbproxy CGI — uhttpd REST agent installed at /www/cgi-bin/sbproxy.
# Endpoint:  http://<router>/cgi-bin/sbproxy?action=<...>
# Authentication: Authorization: Bearer <token>, matching /etc/sbproxy/token.
# X-SB-Token remains supported on HTTP servers that forward custom CGI headers.
#
# GET  ?action=status        -> {ssids:[...], health:{...}, meta:{...}} — meta carries
#                               the effective settings.sh values a console needs
# GET  ?action=get_conf      -> wifi-socks.conf as text/plain
# GET  ?action=backups       -> {backups:[...]}
# POST ?action=save_conf     body=text  -> ghi wifi-socks.conf (validate)
# POST ?action=dryrun_conf   body=text  -> validate candidate config without writing it
# POST ?action=apply         -> mandatory quiet dry-run, then run apply.sh
# POST ?action=set_sock      body=json {idx,host,port,user,pass} -> change SOCKS without Wi-Fi reload
# POST ?action=rotate_mac    body=json {idx,oui?} -> rotate BSSID/MAC, optionally changing provider OUI
# POST ?action=rollback      body=json {name?} -> rollback
# POST ?action=uninstall     -> remove project-managed configuration
# GET  ?action=health_now    -> run an immediate health probe
# GET  ?action=diagnose_ssid&idx=N -> walk the data path of one SSID (wifi, bridge, dhcp, nft, routing, sing-box, proxy) and name the broken link
# POST ?action=probe_proxy   body json {host,port,user?,pass?,type?} -> curl through that proxy now, with the reason it fails
# GET  ?action=gateway       -> default Internet gateway route/link/DNS/HTTP status + interface list
# POST ?action=set_gateway   body json {interface} -> pin the expected uplink ("" = automatic)
# POST ?action=switch_gateway body json {interface} -> make that interface the uplink (route metrics) and pin it
# GET  ?action=get_pool&idx=N -> {proxies:[...], assignments:[...]} pool of one Wi-Fi
# POST ?action=save_pool     body json {idx,proxies:[...]} -> replace that Wi-Fi's pool
# POST ?action=assign_proxy  body json {idx,assignments:[{mac,slot}]} -> pin devices, no reload
# POST ?action=rebalance     body json {idx,macs:[...],proxies?,seed?} -> spread devices evenly
# GET  ?action=clients       -> {clients:[...]} devices per SSID (mac/ip/time/in-out/banned)
# POST ?action=kick   body json {idx,mac} -> deauth one client (not persistent)
# POST ?action=ban    body json {idx,mac} -> persistently block a MAC from an SSID
# POST ?action=unban  body json {idx,mac} -> remove a MAC ban
# POST ?action=update[&force=1]  body=binary package (.tar.gz/.zip) -> self-update code

# ---- env / config ----
[ -f /etc/sbproxy/env ] && . /etc/sbproxy/env
SB_ROOT="${SB_ROOT:-/root/sbproxy}"
CONF="${CONF:-$SB_ROOT/config/wifi-socks.conf}"
TOKEN_FILE="${TOKEN_FILE:-/etc/sbproxy/token}"
HEALTH_FILE="${HEALTH_FILE:-/tmp/sbproxy-health.json}"
MAX_BODY_BYTES="${MAX_BODY_BYTES:-262144}"
ENV_FILE="${ENV_FILE:-/etc/sbproxy/env}"
# Update packages are binary and larger than text/JSON bodies.
MAX_UPDATE_BYTES="${MAX_UPDATE_BYTES:-8388608}"

# ---- helpers ----
hdr() {
  printf 'Status: %s\r\n' "$1"
  printf 'Content-Type: %s\r\n' "$2"
  printf 'Access-Control-Allow-Origin: *\r\n'
  printf 'Access-Control-Allow-Headers: Authorization, X-SB-Token, Content-Type\r\n'
  printf 'Access-Control-Allow-Methods: GET, POST, OPTIONS\r\n'
  printf 'Cache-Control: no-store\r\n\r\n'
}
json_ok()  { hdr "200 OK" "application/json"; printf '%s\n' "$1"; exit 0; }
json_err() { hdr "$1" "application/json"; jq -n --arg e "$2" '{ok:false,error:$e}'; exit 0; }
have() { command -v "$1" >/dev/null 2>&1; }
# Effective settings.sh numbers, read in a subshell so nothing here inherits the
# file's other variables. A console derives subnets and TPROXY ports from these
# instead of repeating the defaults and drifting when settings.sh is edited.
settings_numbers() {
  (
    [ -f "$SB_ROOT/config/settings.sh" ] && . "$SB_ROOT/config/settings.sh" 2>/dev/null
    printf '%s %s %s %s %s\n' "${NET_BASE:-10}" "${TPROXY_PORT_BASE:-12000}" \
      "${BSSID_LIMIT:-16}" "${POOL_PORT_BASE:-13000}" "${POOL_PORT_STRIDE:-256}"
  ) 2>/dev/null
}
trim_field() { printf '%s' "$1" | sed 's/^[[:space:]]*//; s/[[:space:]]*$//'; }
# Some jq builds emit CRLF. Anything parsed back out of jq gets the CR removed,
# or a MAC arrives as "aa:...:01\r" and is rejected as malformed.
jq_r() { jq -r "$@" | tr -d '\r'; }
query_field() { echo "$QUERY_STRING" | sed -n "s/.*\\(^\\|&\\)$1=\\([^&]*\\).*/\\2/p"; }
# A MAC as the rest of the project spells it: lowercase, colon separated.
normalise_mac() { printf '%s' "$1" | tr 'A-Z' 'a-z'; }
valid_mac() {
  case "$1" in
    [0-9a-f][0-9a-f]:[0-9a-f][0-9a-f]:[0-9a-f][0-9a-f]:[0-9a-f][0-9a-f]:[0-9a-f][0-9a-f]:[0-9a-f][0-9a-f]) return 0 ;;
  esac
  return 1
}
# Rows the pool scripts accept, from a JSON array of proxy objects. jq has
# already rejected control characters and pipes, so splitting on | stays safe.
pool_rows_from_body() { # jq-path -> writes rows, one per line
  jq_r "$1"'[] | [.type, .host, (.port|tostring), (.user // ""), (.pass // ""), (.label // "")] | join("|")' \
    "$BODY_FILE"
}
# Shape check shared by save_pool and rebalance. $1 is the jq path of the array.
POOL_ARRAY_SHAPE='
  def integer: if type == "number" then floor == . else false end;
  def clean: if type != "string" then false
             else all(explode[]; . >= 32 and (. < 127 or . > 159)) and (index("|") | null == .) end;
  type == "array" and all(.[];
    (.type == "socks5" or .type == "http") and
    (.host | clean) and (.host | length > 0) and (.host | length <= 253) and
    (.port | integer) and .port >= 1 and .port <= 65535 and
    ((has("user") | not) or ((.user | clean) and (.user | length <= 255))) and
    ((has("pass") | not) or ((.pass | clean) and (.pass | length <= 255))) and
    ((has("label") | not) or ((.label | clean) and (.label | length <= 64))))
'
# The one thing jq cannot express without test(): the host character set.
check_pool_hosts() { # rows-file
  while IFS='|' read -r _pt _ph _pp _pu _ppw _pl; do
    [ -n "$_ph" ] || json_err "400 Bad Request" "host trống"
    case "$_ph" in *[!A-Za-z0-9._:-]*) json_err "400 Bad Request" "host chứa ký tự không hợp lệ: $_ph" ;; esac
  done < "$1"
}
body_has_nul() {
  if have od; then
    od -An -tu1 "$BODY_FILE" 2>/dev/null \
      | awk '{for (i=1; i<=NF; i++) if ($i == 0) found=1} END {exit found ? 0 : 1}'
  elif have hexdump; then
    hexdump -v -e '/1 "%u\n"' "$BODY_FILE" 2>/dev/null | grep -qx '0'
  else
    return 2
  fi
}

have jq || { hdr "500 Internal Server Error" "text/plain"; echo "thiếu package jq"; exit 0; }

# ---- CORS preflight ----
[ "$REQUEST_METHOD" = "OPTIONS" ] && { hdr "204 No Content" "text/plain"; exit 0; }

# ---- auth ----
TOKEN="$(cat "$TOKEN_FILE" 2>/dev/null)"
[ -n "$TOKEN" ] || json_err "500 Internal Server Error" "chưa có token (chạy install-agent.sh)"
REQUEST_TOKEN="${HTTP_X_SB_TOKEN:-}"
case "${HTTP_AUTHORIZATION:-}" in
  Bearer\ *) [ -n "$REQUEST_TOKEN" ] || REQUEST_TOKEN="${HTTP_AUTHORIZATION#Bearer }" ;;
esac
[ "$REQUEST_TOKEN" = "$TOKEN" ] || json_err "401 Unauthorized" "token sai hoặc thiếu Authorization: Bearer"

# ---- parse action ----
ACTION="$(echo "$QUERY_STRING" | sed -n 's/.*\(^\|&\)action=\([a-z_]*\).*/\2/p')"
BODY_FILE=""
TMP_CONF=""
cleanup() {
  [ -z "$BODY_FILE" ] || rm -f "$BODY_FILE"
  [ -z "$TMP_CONF" ] || rm -f "$TMP_CONF"
}
trap cleanup EXIT
trap 'exit 1' HUP INT TERM

if [ "$REQUEST_METHOD" = "POST" ]; then
  case "$MAX_BODY_BYTES" in ''|*[!0-9]*|0) MAX_BODY_BYTES=262144;; esac
  case "$MAX_UPDATE_BYTES" in ''|*[!0-9]*|0) MAX_UPDATE_BYTES=8388608;; esac
  # The update package is binary (gzip/zip), so it gets a larger cap and is
  # exempt from the NUL check that protects the text/JSON endpoints.
  BODY_LIMIT="$MAX_BODY_BYTES"
  [ "$ACTION" = "update" ] && BODY_LIMIT="$MAX_UPDATE_BYTES"
  case "${CONTENT_LENGTH:-}" in
    '' ) ;;
    *[!0-9]* ) json_err "400 Bad Request" "Content-Length không hợp lệ";;
    * ) [ "$CONTENT_LENGTH" -le "$BODY_LIMIT" ] 2>/dev/null \
          || json_err "413 Payload Too Large" "body vượt quá $BODY_LIMIT byte";;
  esac
  umask 077
  BODY_FILE="$(mktemp "${TMPDIR:-/tmp}/sbproxy-cgi-body.XXXXXX")" \
    || json_err "500 Internal Server Error" "không tạo được body tạm"
  cat > "$BODY_FILE" || json_err "400 Bad Request" "không đọc được body"
  body_size="$(wc -c < "$BODY_FILE" | tr -d ' ')"
  [ "$body_size" -le "$BODY_LIMIT" ] 2>/dev/null \
    || json_err "413 Payload Too Large" "body vượt quá $BODY_LIMIT byte"
  if [ "$ACTION" != "update" ]; then
    body_has_nul; nul_rc=$?
    [ "$nul_rc" -ne 0 ] || json_err "400 Bad Request" "body chứa byte NUL không hợp lệ"
    [ "$nul_rc" -ne 2 ] || json_err "500 Internal Server Error" "thiếu od/hexdump để kiểm tra body"
  fi
fi

require_json_object() {
  [ -n "$BODY_FILE" ] && jq -e 'type == "object"' "$BODY_FILE" >/dev/null 2>&1 \
    || json_err "400 Bad Request" "body JSON không hợp lệ"
}

require_empty_or_json_object() {
  [ ! -s "$BODY_FILE" ] || require_json_object
}

require_json_shape() {
  jq -e "$1" "$BODY_FILE" >/dev/null 2>&1 \
    || json_err "400 Bad Request" "$2"
}

require_valid_idx() {
  value="$1"
  case "$value" in *[!0-9]*|'') json_err "400 Bad Request" "idx không hợp lệ" ;; esac
  [ "$value" -ge 1 ] 2>/dev/null && [ "$value" -le 200 ] 2>/dev/null \
    || json_err "400 Bad Request" "idx ngoài phạm vi 1..200"
}

valid_snapshot_name() {
  [ "${#1}" -le 128 ] || return 1
  case "$1" in ""|*[!A-Za-z0-9._-]*|*..*) return 1 ;; esac
  return 0
}

# Build SSID JSON without exposing wifi_key or proxy password.
# Legacy 10/11-column rows default to SOCKS5.
ssids_json() {
  { awk -F'|' 'NF == 10 || NF == 11 || NF == 12 { if ($0 !~ /^[[:space:]]*#/) print }' "$CONF" 2>/dev/null | \
    while IFS='|' read -r name band idx _wifi_key host port user pass iso web oui proxy_type; do
      idx="$(trim_field "$idx")"
      case "$idx" in ''|*[!0-9]*|0*) continue;; esac
      [ "$idx" -ge 1 ] 2>/dev/null && [ "$idx" -le 200 ] 2>/dev/null || continue
      iso="$(trim_field "$iso")"; web="$(trim_field "$web")"
      oui="$(trim_field "$oui")"
      proxy_type="$(trim_field "${proxy_type:-socks5}")"
      case "$proxy_type" in socks5|http) :;; *) proxy_type="socks5";; esac
      mac="$(uci -q get "wireless.w$idx.macaddr" 2>/dev/null || true)"
      jq -n --arg name "$name" --arg band "$band" --argjson idx "$idx" \
            --arg host "$host" --arg port "$(trim_field "$port")" --arg user "$user" \
            --arg oui "$oui" --arg mac "$mac" --arg proxy_type "$proxy_type" \
            --argjson iso "$([ "$iso" = 1 ] && echo true || echo false)" \
            --argjson web "$([ "$web" = 1 ] && echo true || echo false)" \
        '{name:$name,band:$band,idx:$idx,host:$host,port:$port,proxy_type:$proxy_type,hasAuth:($user!=""),isolate:$iso,webrtc:$web,mac_oui:$oui,macaddr:$mac}'
    done; } | jq -s 'sort_by(.idx)'
}

case "$ACTION" in
  status)
    S="$(ssids_json)"; [ -n "$S" ] || S="[]"
    H="$(cat "$HEALTH_FILE" 2>/dev/null)"; [ -n "$H" ] || H='{}'
    printf '%s' "$H" | jq -e '
      type == "object" and
      ((has("probes") | not) or ((.probes | type == "object") and all(.probes[]; type == "object")))
    ' >/dev/null 2>&1 || H='{}'
    applied="false"; [ -f "$SINGBOX_CONF" ] || [ -f /etc/sing-box/config.json ] && applied="true"
    running="false"; pgrep -f sing-box >/dev/null 2>&1 && running="true"
    ver="$(tr -d ' \r\n' < "$SB_ROOT/VERSION" 2>/dev/null || true)"; [ -n "$ver" ] || ver="unknown"
    # shellcheck disable=SC2046  # three plain integers, deliberately split
    set -- $(settings_numbers)
    net_base="${1:-10}"; tproxy_base="${2:-12000}"; bssid_limit="${3:-16}"
    pool_base="${4:-13000}"; pool_stride="${5:-256}"
    case "$net_base$tproxy_base$bssid_limit$pool_base$pool_stride" in
      ''|*[!0-9]*)
        net_base=10; tproxy_base=12000; bssid_limit=16
        pool_base=13000; pool_stride=256
        ;;
    esac
    json_ok "$(jq -n --argjson ssids "$S" --argjson health "$H" \
                     --argjson running "$running" --argjson applied "$applied" --arg ver "$ver" \
                     --argjson net_base "$net_base" --argjson tproxy_port_base "$tproxy_base" \
                     --argjson bssid_limit "$bssid_limit" \
                     --argjson pool_port_base "$pool_base" \
                     --argjson pool_port_stride "$pool_stride" \
      '{ok:true, ssids:$ssids, health:$health,
        meta:{singbox_running:$running, applied:$applied, version:$ver,
              net_base:$net_base, tproxy_port_base:$tproxy_port_base,
              bssid_limit:$bssid_limit,
              pool_port_base:$pool_port_base, pool_port_stride:$pool_port_stride}}')"
    ;;

  get_conf)
    hdr "200 OK" "text/plain"; cat "$CONF" 2>/dev/null; exit 0
    ;;

  save_conf)
    [ "$REQUEST_METHOD" = "POST" ] || json_err "405 Method Not Allowed" "cần POST"
    [ -s "$BODY_FILE" ] || json_err "400 Bad Request" "body rỗng"
    # Structural validation gives a concise line error before the shared
    # validator checks all bounds, duplicate indexes, keys, flags, and OUI.
    bad="$(awk -F'|' '
      /^[[:space:]]*($|#)/ {next}
      NF != 10 && NF != 11 && NF != 12 {print NR; exit}
    ' "$BODY_FILE")"
    [ -z "$bad" ] || json_err "400 Bad Request" "dòng $bad cần đúng 10, 11 hoặc 12 cột phân tách '|'"
    TMP_CONF="$(mktemp "${CONF}.candidate.XXXXXX")" \
      || json_err "500 Internal Server Error" "không tạo được config tạm"
    cp "$BODY_FILE" "$TMP_CONF" \
      || json_err "500 Internal Server Error" "không tạo được config tạm"
    VALIDATE_OUT="$(cd "$SB_ROOT" && SB_ROOT="$SB_ROOT" CONF="$TMP_CONF" \
      sh -c '. "$SB_ROOT/scripts/lib.sh"; validate_conf' 2>&1)"; VALIDATE_RC=$?
    [ "$VALIDATE_RC" -eq 0 ] \
      || json_err "400 Bad Request" "config không hợp lệ: $VALIDATE_OUT"
    # Back up before writing desired config; the following apply uses --no-backup.
    OUT="$(cd "$SB_ROOT" && sh scripts/backup.sh pre-apply 2>&1)" || json_err "500 Internal Server Error" "backup trước apply thất bại"
    mv "$TMP_CONF" "$CONF" || json_err "500 Internal Server Error" "không lưu được config"
    TMP_CONF=""
    json_ok "$(jq -n '{ok:true, saved:true}')"
    ;;

  dryrun_conf)
    [ "$REQUEST_METHOD" = "POST" ] || json_err "405 Method Not Allowed" "cần POST"
    [ -s "$BODY_FILE" ] || json_err "400 Bad Request" "body rỗng"
    TMP_CONF="$(mktemp "${TMPDIR:-/tmp}/sbproxy-dryrun-conf.XXXXXX")" \
      || json_err "500 Internal Server Error" "không tạo được config dry-run"
    cp "$BODY_FILE" "$TMP_CONF" \
      || json_err "500 Internal Server Error" "không tạo được config dry-run"
    OUT="$(cd "$SB_ROOT" && CONF="$TMP_CONF" DRYRUN=1 DRYRUN_QUIET=1 sh scripts/apply.sh --no-backup 2>&1)"; RC=$?
    rm -f "$TMP_CONF"
    TMP_CONF=""
    json_ok "$(jq -n --arg log "$OUT" --arg phase "dryrun" --argjson rc "$RC" '{ok:($rc==0), rc:$rc, phase:$phase, log:$log}')"
    ;;

  apply)
    [ "$REQUEST_METHOD" = "POST" ] || json_err "405 Method Not Allowed" "cần POST"
    require_empty_or_json_object
    # Every caller, including the web UI, must pass the same complete dry-run
    # immediately before router state can change.
    CHECK="$(cd "$SB_ROOT" && DRYRUN=1 DRYRUN_QUIET=1 sh scripts/apply.sh --no-backup 2>&1)"; CHECK_RC=$?
    [ "$CHECK_RC" -eq 0 ] || json_ok "$(jq -n --arg log "$CHECK" --arg phase "dryrun" --argjson rc "$CHECK_RC" '{ok:false, rc:$rc, phase:$phase, log:$log}')"
    # Authoritative shared apply path. Its generated-UCI guard scopes every
    # block-admin rule to the SSID gateway before changing router state.
    OUT="$(cd "$SB_ROOT" && sh scripts/apply.sh --no-backup 2>&1)"; RC=$?
    json_ok "$(jq -n --arg log "$OUT" --arg phase "apply" --argjson rc "$RC" '{ok:($rc==0), rc:$rc, phase:$phase, log:$log}')"
    ;;

  set_sock)
    [ "$REQUEST_METHOD" = "POST" ] || json_err "405 Method Not Allowed" "cần POST"
    require_json_object
    require_json_shape '
      def integer: if type == "number" then floor == . else false end;
      def clean:
        if type != "string" then false
        else all(explode[]; . >= 32 and (. < 127 or . > 159)) end;
      (.idx | integer) and (.host | clean) and (.port | integer) and
      ((has("user") | not) or (.user | clean)) and
      ((has("pass") | not) or (.pass | clean)) and
      ((has("type") | not) or (.type == "socks5" or .type == "http"))
    ' "idx/host/port/user/pass/type sai kiểu hoặc chứa ký tự điều khiển"
    idx="$(jq -r '.idx' "$BODY_FILE")"
    host="$(jq -r '.host' "$BODY_FILE")"
    port="$(jq -r '.port' "$BODY_FILE")"
    user="$(jq -r '.user // ""' "$BODY_FILE")"
    pass="$(jq -r '.pass // ""' "$BODY_FILE")"
    proxy_type="$(jq -r '.type // "socks5"' "$BODY_FILE")"
    [ -n "$idx" ] && [ -n "$host" ] && [ -n "$port" ] || json_err "400 Bad Request" "thiếu idx/host/port"
    require_valid_idx "$idx"
    case "$port" in *[!0-9]*|'') json_err "400 Bad Request" "port không hợp lệ" ;; esac
    [ "$port" -ge 1 ] 2>/dev/null && [ "$port" -le 65535 ] 2>/dev/null \
      || json_err "400 Bad Request" "port ngoài phạm vi 1..65535"
    case "$host" in *[!A-Za-z0-9._:-]*) json_err "400 Bad Request" "host chứa ký tự không hợp lệ" ;; esac
    [ "${#host}" -le 253 ] || json_err "400 Bad Request" "host dài quá 253 ký tự"
    [ "${#user}" -le 255 ] && [ "${#pass}" -le 255 ] \
      || json_err "400 Bad Request" "user/pass dài quá 255 ký tự"
    case "$user$pass" in *'|'*) json_err "400 Bad Request" "user/pass không được chứa ký tự |" ;; esac
    OUT="$(cd "$SB_ROOT" && sh scripts/set-sock.sh "$idx" "$host" "$port" "$user" "$pass" "$proxy_type" 2>&1)"; RC=$?
    json_ok "$(jq -n --arg log "$OUT" --argjson rc "$RC" '{ok:($rc==0), rc:$rc, log:$log}')"
    ;;

  rotate_mac)
    [ "$REQUEST_METHOD" = "POST" ] || json_err "405 Method Not Allowed" "cần POST"
    require_json_object
    require_json_shape '
      def integer: if type == "number" then floor == . else false end;
      (.idx | integer) and ((has("oui") | not) or (.oui | type == "string"))
    ' "idx/oui sai kiểu"
    idx="$(jq -r '.idx' "$BODY_FILE")"
    require_valid_idx "$idx"
    has_oui="$(jq -r 'has("oui")' "$BODY_FILE")"
    oui="$(jq -r '.oui // ""' "$BODY_FILE")"
    [ -z "$oui" ] || echo "$oui" | grep -Eq '^[0-9A-Fa-f]{2}(:[0-9A-Fa-f]{2}){2}$' \
      || json_err "400 Bad Request" "oui phải dạng AA:BB:CC hoặc để trống"
    if [ "$has_oui" = "true" ]; then
      OUT="$(cd "$SB_ROOT" && sh scripts/rotate-mac.sh "$idx" "$oui" 2>&1)"; RC=$?
    else
      OUT="$(cd "$SB_ROOT" && sh scripts/rotate-mac.sh "$idx" 2>&1)"; RC=$?
    fi
    mac="$(uci -q get "wireless.w$idx.macaddr" 2>/dev/null || true)"
    json_ok "$(jq -n --arg log "$OUT" --arg mac "$mac" --arg oui "$oui" --argjson rc "$RC" '{ok:($rc==0), rc:$rc, log:$log, mac:$mac, oui:$oui}')"
    ;;

  rollback)
    [ "$REQUEST_METHOD" = "POST" ] || json_err "405 Method Not Allowed" "cần POST"
    require_json_object
    require_json_shape '((has("name") | not) or (.name | type == "string"))' "name sai kiểu"
    name="$(jq -r '.name // ""' "$BODY_FILE")"
    [ -z "$name" ] || valid_snapshot_name "$name" \
      || json_err "400 Bad Request" "tên backup không hợp lệ"
    OUT="$(cd "$SB_ROOT" && SB_YES=1 sh scripts/rollback.sh "$name" 2>&1)"; RC=$?
    json_ok "$(jq -n --arg log "$OUT" --argjson rc "$RC" '{ok:($rc==0), rc:$rc, log:$log}')"
    ;;

  uninstall)
    [ "$REQUEST_METHOD" = "POST" ] || json_err "405 Method Not Allowed" "cần POST"
    require_empty_or_json_object
    OUT="$(cd "$SB_ROOT" && sh scripts/uninstall.sh 2>&1)"; RC=$?
    json_ok "$(jq -n --arg log "$OUT" --argjson rc "$RC" '{ok:($rc==0), rc:$rc, log:$log}')"
    ;;

  update)
    # The package is unpacked and redeployed by this very process; its umask
    # must not strip the execute bits uhttpd needs on the new CGI.
    umask 022
    [ "$REQUEST_METHOD" = "POST" ] || json_err "405 Method Not Allowed" "cần POST"
    [ -s "$BODY_FILE" ] || json_err "400 Bad Request" "body rỗng — cần package .tar.gz/.zip"
    force_flag=""
    echo "$QUERY_STRING" | grep -Eq '(^|&)force=1(&|$)' && force_flag="--force"
    from_ver="$(tr -d ' \r\n' < "$SB_ROOT/VERSION" 2>/dev/null || true)"; [ -n "$from_ver" ] || from_ver="unknown"
    if [ -n "$force_flag" ]; then
      OUT="$(cd "$SB_ROOT" && sh scripts/self-update.sh "$BODY_FILE" --force 2>&1)"; RC=$?
    else
      OUT="$(cd "$SB_ROOT" && sh scripts/self-update.sh "$BODY_FILE" 2>&1)"; RC=$?
    fi
    to_ver="$(tr -d ' \r\n' < "$SB_ROOT/VERSION" 2>/dev/null || true)"; [ -n "$to_ver" ] || to_ver="unknown"
    json_ok "$(jq -n --arg log "$OUT" --argjson rc "$RC" --arg from "$from_ver" --arg to "$to_ver" \
      '{ok:($rc==0), rc:$rc, log:$log, from:$from, to:$to}')"
    ;;

  backups)
    # BusyBox-compatible mtime ordering; snapshot names are generated safely.
    # shellcheck disable=SC2010
    B="$(ls -1dt "${BACKUP_DIR:-/root/sbproxy-backups}"/*/ 2>/dev/null | grep -v '/latest/$' | sed 's#.*/\([^/]*\)/$#\1#' | jq -R . | jq -s '.')"
    [ -n "$B" ] || B="[]"
    json_ok "$(jq -n --argjson b "$B" '{ok:true, backups:$b}')"
    ;;

  backup)
    [ "$REQUEST_METHOD" = "POST" ] || json_err "405 Method Not Allowed" "cần POST"
    require_json_object
    require_json_shape '((has("label") | not) or (.label | type == "string"))' "label sai kiểu"
    label="$(jq -r '.label // "ui"' "$BODY_FILE" 2>/dev/null)"
    valid_snapshot_name "$label" || json_err "400 Bad Request" "nhãn backup không hợp lệ"
    OUT="$(cd "$SB_ROOT" && sh scripts/backup.sh "$label" 2>&1)"; RC=$?
    json_ok "$(jq -n --arg log "$OUT" --argjson rc "$RC" '{ok:($rc==0), rc:$rc, log:$log}')"
    ;;

  download_backup)
    # Download an off-device backup for recovery after reflash or brick.
    name="$(echo "$QUERY_STRING" | sed -n 's/.*[?&]name=\([A-Za-z0-9._-]*\).*/\1/p')"
    valid_snapshot_name "$name" || json_err "400 Bad Request" "tên backup không hợp lệ"
    dir="${BACKUP_DIR:-/root/sbproxy-backups}/$name"
    f="$dir/sysupgrade-backup.tar.gz"
    [ -f "$f" ] || f="$dir/etc-config.tar.gz"
    [ -f "$f" ] || json_err "404 Not Found" "không thấy file backup cho '$name'"
    printf 'Status: 200 OK\r\n'
    printf 'Content-Type: application/gzip\r\n'
    printf 'Content-Disposition: attachment; filename="sbproxy-%s.tar.gz"\r\n' "$name"
    printf 'Access-Control-Allow-Origin: *\r\n\r\n'
    cat "$f"
    exit 0
    ;;

  health_now)
    [ -x /usr/sbin/sbproxy-healthd ] && /usr/sbin/sbproxy-healthd --once >/dev/null 2>&1
    H="$(cat "$HEALTH_FILE" 2>/dev/null)"; [ -n "$H" ] || H='{}'
    printf '%s' "$H" | jq -e '
      type == "object" and
      ((has("probes") | not) or ((.probes | type == "object") and all(.probes[]; type == "object")))
    ' >/dev/null 2>&1 || H='{}'
    json_ok "$(jq -n --argjson health "$H" '{ok:true, health:$health}')"
    ;;

  gateway)
    OUT="$(cd "$SB_ROOT" && sh scripts/gateway.sh 2>&1)"; RC=$?
    [ "$RC" -eq 0 ] || json_err "500 Internal Server Error" "kiểm tra gateway thất bại"
    printf '%s' "$OUT" | jq -e 'type == "object"' >/dev/null 2>&1 || json_err "500 Internal Server Error" "gateway trả dữ liệu không hợp lệ"
    json_ok "$OUT"
    ;;

  set_gateway)
    # Which interface the gateway check treats as the uplink. Empty means
    # automatic: whatever the default route uses is accepted. The value is
    # written into a file the agent sources, so the name is restricted to
    # characters that cannot mean anything to a shell.
    [ "$REQUEST_METHOD" = "POST" ] || json_err "405 Method Not Allowed" "cần POST"
    require_json_object
    require_json_shape '(has("interface") | not) or (.interface | type == "string")' \
      "interface phải là chuỗi"
    iface="$(trim_field "$(jq -r '.interface // ""' "$BODY_FILE")")"
    case "$iface" in
      "") : ;;
      *[!A-Za-z0-9_.-]*) json_err "400 Bad Request" "tên interface chỉ được dùng chữ, số, . _ -" ;;
    esac
    [ "${#iface}" -le 32 ] || json_err "400 Bad Request" "tên interface dài quá 32 ký tự"
    ENV_TMP="$ENV_FILE.$$"
    mkdir -p "$(dirname "$ENV_FILE")" 2>/dev/null
    {
      [ -f "$ENV_FILE" ] && awk '!/^[[:space:]]*GATEWAY_EXPECTED_INTERFACE=/' "$ENV_FILE"
      printf 'GATEWAY_EXPECTED_INTERFACE=%s\n' "$iface"
    } > "$ENV_TMP" 2>/dev/null && cat "$ENV_TMP" > "$ENV_FILE" 2>/dev/null || {
      rm -f "$ENV_TMP"
      json_err "500 Internal Server Error" "không ghi được $ENV_FILE"
    }
    rm -f "$ENV_TMP"
    json_ok "$(jq -n --arg interface "$iface" \
      '{ok:true, interface:$interface, automatic:($interface == "")}')"
    ;;

  diagnose_ssid)
    # Read-only walk of one SSID's data path; the answer says which link is
    # broken so "connected but no Internet" stops being a guessing game.
    [ "$REQUEST_METHOD" = "GET" ] || json_err "405 Method Not Allowed" "cần GET"
    idx="$(query_field idx)"
    require_valid_idx "$idx"
    OUT="$(cd "$SB_ROOT" && sh scripts/diagnose-ssid.sh "$idx" 2>/dev/null)"
    printf '%s' "$OUT" | jq -e 'type == "object" and (.checks | type == "array")' >/dev/null 2>&1 \
      || json_err "500 Internal Server Error" "diagnose-ssid trả dữ liệu không hợp lệ"
    json_ok "$OUT"
    ;;

  probe_proxy)
    # Diagnose one proxy from the router: the same request healthd makes, but
    # the answer says why it failed (curl exit, error line, handshake tail).
    [ "$REQUEST_METHOD" = "POST" ] || json_err "405 Method Not Allowed" "cần POST"
    require_json_object
    require_json_shape '
      def integer: if type == "number" then floor == . else false end;
      def clean:
        if type != "string" then false
        else all(explode[]; . >= 32 and (. < 127 or . > 159)) end;
      (.host | clean) and (.port | integer) and
      ((has("user") | not) or (.user | clean)) and
      ((has("pass") | not) or (.pass | clean)) and
      ((has("type") | not) or (.type == "socks5" or .type == "http"))
    ' "host/port/user/pass/type sai kiểu hoặc chứa ký tự điều khiển"
    host="$(jq -r '.host' "$BODY_FILE")"
    port="$(jq -r '.port' "$BODY_FILE")"
    user="$(jq -r '.user // ""' "$BODY_FILE")"
    pass="$(jq -r '.pass // ""' "$BODY_FILE")"
    proxy_type="$(jq -r '.type // "socks5"' "$BODY_FILE")"
    case "$host" in ''|*[!A-Za-z0-9._:-]*) json_err "400 Bad Request" "host không hợp lệ" ;; esac
    [ "${#host}" -le 253 ] || json_err "400 Bad Request" "host dài quá"
    [ "$port" -ge 1 ] 2>/dev/null && [ "$port" -le 65535 ] 2>/dev/null \
      || json_err "400 Bad Request" "port không hợp lệ"
    [ "${#user}" -le 255 ] && [ "${#pass}" -le 255 ] || json_err "400 Bad Request" "user/pass dài quá 255 byte"
    OUT="$(cd "$SB_ROOT" && sh scripts/probe-proxy.sh "$host" "$port" "$user" "$pass" "$proxy_type" 2>/dev/null)"
    printf '%s' "$OUT" | jq -e 'type == "object"' >/dev/null 2>&1 \
      || json_err "500 Internal Server Error" "probe-proxy trả dữ liệu không hợp lệ"
    json_ok "$OUT"
    ;;

  switch_gateway)
    # Change the router's real uplink, not just the expectation: the chosen
    # interface gets the best default-route metric and every other uplink
    # steps behind it. scripts/switch-gateway.sh does the validation (exists,
    # up, has a default route, is not a proxied SSID bridge) and pins the
    # choice in the env file afterwards.
    [ "$REQUEST_METHOD" = "POST" ] || json_err "405 Method Not Allowed" "cần POST"
    require_json_object
    require_json_shape '(.interface | type == "string") and (.interface | length > 0)'       "interface phải là chuỗi khác rỗng"
    iface="$(trim_field "$(jq -r '.interface' "$BODY_FILE")")"
    case "$iface" in
      "") json_err "400 Bad Request" "thiếu interface" ;;
      *[!A-Za-z0-9_.-]*) json_err "400 Bad Request" "tên interface chỉ được dùng chữ, số, . _ -" ;;
    esac
    [ "${#iface}" -le 32 ] || json_err "400 Bad Request" "tên interface dài quá 32 ký tự"
    OUT="$(cd "$SB_ROOT" && ENV_FILE="$ENV_FILE" sh scripts/switch-gateway.sh "$iface" 2>&1)"; RC=$?
    if [ "$RC" -ne 0 ]; then
      detail="$(printf '%s' "$OUT" | jq -r '.error // empty' 2>/dev/null)"
      json_err "400 Bad Request" "không đổi được đường ra: ${detail:-$OUT}"
    fi
    printf '%s' "$OUT" | jq -e 'type == "object"' >/dev/null 2>&1       || json_err "500 Internal Server Error" "switch-gateway trả dữ liệu không hợp lệ"
    json_ok "$OUT"
    ;;

  get_pool)
    [ "$REQUEST_METHOD" = "GET" ] || json_err "405 Method Not Allowed" "cần GET"
    idx="$(query_field idx)"
    require_valid_idx "$idx"
    POOLS_FILE="${POOLS:-$SB_ROOT/config/proxy-pools.conf}"
    ASSIGN="${ASSIGN_FILE:-/etc/sbproxy.assign}"
    proxies="$(awk -F'|' -v want="$idx" '
        function trim(s) { gsub(/^[[:space:]]+|[[:space:]]+$/, "", s); return s }
        { sub(/\r$/, "") }
        /^[[:space:]]*#/ || /^[[:space:]]*$/ { next }
        NF < 6 || NF > 7 { next }
        trim($1) != want { next }
        { printf "%d\t%s\t%s\t%s\t%s\t%s\t%s\n", n++, tolower(trim($2)), trim($3), trim($4),
                 $5, $6, (NF >= 7 ? trim($7) : "") }
      ' "$POOLS_FILE" 2>/dev/null \
      | jq -R -s 'split("\n") | map(select(length > 0) | split("\t"))
                  | map({slot:(.[0]|tonumber), type:.[1], host:.[2], port:(.[3]|tonumber),
                         user:.[4], pass:.[5], label:.[6]})')"
    assignments="$(awk -F'|' -v want="$idx" '
        { sub(/\r$/, "") }
        /^[[:space:]]*#/ || /^[[:space:]]*$/ { next }
        NF < 3 { next }
        $1 != want { next }
        { printf "%s\t%s\t%s\n", tolower($2), $3, ($4 == "" ? "auto" : $4) }
      ' "$ASSIGN" 2>/dev/null \
      | jq -R -s 'split("\n") | map(select(length > 0) | split("\t"))
                  | map({mac:.[0], slot:(.[1]|tonumber), source:.[2]})')"
    json_ok "$(jq -n --argjson idx "$idx" --argjson p "${proxies:-[]}" --argjson a "${assignments:-[]}" \
      '{ok:true, idx:$idx, proxies:$p, assignments:$a}')"
    ;;

  save_pool)
    [ "$REQUEST_METHOD" = "POST" ] || json_err "405 Method Not Allowed" "cần POST"
    require_json_object
    require_json_shape '
      def integer: if type == "number" then floor == . else false end;
      (.idx | integer) and (.proxies | '"$POOL_ARRAY_SHAPE"')
    ' "idx/proxies sai kiểu, thiếu trường, hoặc chứa ký tự không hợp lệ"
    idx="$(jq_r '.idx' "$BODY_FILE")"
    require_valid_idx "$idx"
    TMP_POOL="$(mktemp "${TMPDIR:-/tmp}/sbproxy-pool.XXXXXX")" \
      || json_err "500 Internal Server Error" "không tạo được file tạm"
    pool_rows_from_body '.proxies' > "$TMP_POOL"
    check_pool_hosts "$TMP_POOL"
    OUT="$(cd "$SB_ROOT" && sh scripts/pool.sh replace "$idx" "$TMP_POOL" 2>&1)"; RC=$?
    rm -f "$TMP_POOL"
    json_ok "$(jq -n --arg log "$OUT" --argjson rc "$RC" '{ok:($rc==0), rc:$rc, log:$log}')"
    ;;

  assign_proxy)
    [ "$REQUEST_METHOD" = "POST" ] || json_err "405 Method Not Allowed" "cần POST"
    require_json_object
    require_json_shape '
      def integer: if type == "number" then floor == . else false end;
      (.idx | integer) and (.assignments | type == "array") and (.assignments | length > 0) and
      all(.assignments[];
        (.mac | type == "string") and
        (((.slot | integer) and .slot >= 0) or .slot == "none"))
    ' "idx/assignments sai kiểu hoặc rỗng"
    idx="$(jq_r '.idx' "$BODY_FILE")"
    require_valid_idx "$idx"
    # Validate every MAC before running anything: a half-applied batch would
    # leave the operator guessing which devices moved.
    for mac in $(jq_r '.assignments[].mac' "$BODY_FILE"); do
      valid_mac "$(normalise_mac "$mac")" || json_err "400 Bad Request" "MAC không hợp lệ: $mac"
    done
    RESULTS="[]"
    jq_r '.assignments[] | "\(.mac)\t\(.slot)"' "$BODY_FILE" > "${TMPDIR:-/tmp}/sbproxy-assign.$$"
    while IFS="$(printf '\t')" read -r mac slot; do
      [ -n "$mac" ] || continue
      mac="$(normalise_mac "$mac")"
      OUT="$(cd "$SB_ROOT" && sh scripts/assign.sh "$idx" "$mac" "$slot" 2>&1)"; RC=$?
      RESULTS="$(printf '%s' "$RESULTS" | jq --arg m "$mac" --arg s "$slot" --arg log "$OUT" \
        --argjson rc "$RC" '. + [{mac:$m, slot:$s, ok:($rc==0), rc:$rc, log:$log}]')"
    done < "${TMPDIR:-/tmp}/sbproxy-assign.$$"
    rm -f "${TMPDIR:-/tmp}/sbproxy-assign.$$"
    json_ok "$(jq -n --argjson r "$RESULTS" '{ok:($r | all(.ok)), results:$r}')"
    ;;

  rebalance)
    [ "$REQUEST_METHOD" = "POST" ] || json_err "405 Method Not Allowed" "cần POST"
    require_json_object
    require_json_shape '
      def integer: if type == "number" then floor == . else false end;
      (.idx | integer) and (.macs | type == "array") and (.macs | length > 0) and
      all(.macs[]; type == "string") and
      ((has("seed") | not) or ((.seed | integer) and .seed >= 0)) and
      ((has("proxies") | not) or (.proxies | '"$POOL_ARRAY_SHAPE"'))
    ' "idx/macs/proxies/seed sai kiểu hoặc rỗng"
    idx="$(jq_r '.idx' "$BODY_FILE")"
    require_valid_idx "$idx"
    MACS=""
    for mac in $(jq_r '.macs[]' "$BODY_FILE"); do
      mac="$(normalise_mac "$mac")"
      valid_mac "$mac" || json_err "400 Bad Request" "MAC không hợp lệ: $mac"
      MACS="$MACS${MACS:+,}$mac"
    done
    set -- "$idx" --macs "$MACS"
    TMP_POOL=""
    if jq -e 'has("proxies")' "$BODY_FILE" >/dev/null 2>&1; then
      TMP_POOL="$(mktemp "${TMPDIR:-/tmp}/sbproxy-pool.XXXXXX")" \
        || json_err "500 Internal Server Error" "không tạo được file tạm"
      pool_rows_from_body '.proxies' > "$TMP_POOL"
      check_pool_hosts "$TMP_POOL"
      set -- "$@" --pool-file "$TMP_POOL"
    fi
    if jq -e 'has("seed")' "$BODY_FILE" >/dev/null 2>&1; then
      set -- "$@" --seed "$(jq_r '.seed' "$BODY_FILE")"
    fi
    OUT="$(cd "$SB_ROOT" && sh scripts/rebalance.sh "$@" 2>&1)"; RC=$?
    [ -z "$TMP_POOL" ] || rm -f "$TMP_POOL"
    json_ok "$(jq -n --arg log "$OUT" --argjson rc "$RC" '{ok:($rc==0), rc:$rc, log:$log}')"
    ;;

  clients)
    OUT="$(cd "$SB_ROOT" && sh scripts/clients.sh 2>/dev/null)"; RC=$?
    [ "$RC" -eq 0 ] || json_err "500 Internal Server Error" "không đọc được danh sách client"
    printf '%s' "$OUT" | jq -e '
      type == "object" and (.clients | type == "array") and all(.clients[]; type == "object")
    ' >/dev/null 2>&1 || json_err "500 Internal Server Error" "không đọc được danh sách client"
    json_ok "$OUT"
    ;;

  kick|ban|unban)
    [ "$REQUEST_METHOD" = "POST" ] || json_err "405 Method Not Allowed" "cần POST"
    require_json_object
    require_json_shape '
      def integer: if type == "number" then floor == . else false end;
      (.idx | integer) and (.mac | type == "string")
    ' "idx/mac sai kiểu"
    idx="$(jq -r '.idx' "$BODY_FILE")"
    mac="$(jq -r '.mac' "$BODY_FILE")"
    [ -n "$idx" ] && [ -n "$mac" ] || json_err "400 Bad Request" "thiếu idx/mac"
    require_valid_idx "$idx"
    echo "$mac" | grep -Eiq '^([0-9a-f]{2}:){5}[0-9a-f]{2}$' || json_err "400 Bad Request" "mac không hợp lệ"
    OUT="$(cd "$SB_ROOT" && sh "scripts/$ACTION.sh" "$idx" "$mac" 2>&1)"; RC=$?
    json_ok "$(jq -n --arg log "$OUT" --argjson rc "$RC" '{ok:($rc==0), rc:$rc, log:$log}')"
    ;;

  *)
    json_err "400 Bad Request" "action không hợp lệ: '$ACTION'"
    ;;
esac
