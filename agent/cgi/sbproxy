#!/bin/sh
# sbproxy CGI — uhttpd REST agent installed at /www/cgi-bin/sbproxy.
# Endpoint:  http://<router>/cgi-bin/sbproxy?action=<...>
# Authentication header: X-SB-Token: <token>, matching /etc/sbproxy/token.
#
# GET  ?action=status        -> {ssids:[...], health:{...}, meta:{...}}
# GET  ?action=get_conf      -> wifi-socks.conf as text/plain
# GET  ?action=backups       -> {backups:[...]}
# POST ?action=save_conf     body=text  -> ghi wifi-socks.conf (validate)
# POST ?action=apply         -> run apply.sh and return its log
# POST ?action=set_sock      body=json {idx,host,port,user,pass} -> change SOCKS without Wi-Fi reload
# POST ?action=rollback      body=json {name?} -> rollback
# POST ?action=uninstall     -> remove project-managed configuration
# GET  ?action=health_now    -> run an immediate health probe

# ---- env / config ----
[ -f /etc/sbproxy/env ] && . /etc/sbproxy/env
SB_ROOT="${SB_ROOT:-/root/sbproxy}"
CONF="${CONF:-$SB_ROOT/config/wifi-socks.conf}"
TOKEN_FILE="${TOKEN_FILE:-/etc/sbproxy/token}"
HEALTH_FILE="${HEALTH_FILE:-/tmp/sbproxy-health.json}"

# ---- helpers ----
hdr() {
  printf 'Status: %s\r\n' "$1"
  printf 'Content-Type: %s\r\n' "$2"
  printf 'Access-Control-Allow-Origin: *\r\n'
  printf 'Access-Control-Allow-Headers: X-SB-Token, Content-Type\r\n'
  printf 'Access-Control-Allow-Methods: GET, POST, OPTIONS\r\n'
  printf 'Cache-Control: no-store\r\n\r\n'
}
json_ok()  { hdr "200 OK" "application/json"; printf '%s\n' "$1"; exit 0; }
json_err() { hdr "$1" "application/json"; jq -n --arg e "$2" '{ok:false,error:$e}'; exit 0; }
have() { command -v "$1" >/dev/null 2>&1; }

have jq || { hdr "500 Internal Server Error" "text/plain"; echo "thiếu package jq"; exit 0; }

# ---- CORS preflight ----
[ "$REQUEST_METHOD" = "OPTIONS" ] && { hdr "204 No Content" "text/plain"; exit 0; }

# ---- auth ----
TOKEN="$(cat "$TOKEN_FILE" 2>/dev/null)"
[ -n "$TOKEN" ] || json_err "500 Internal Server Error" "chưa có token (chạy install-agent.sh)"
[ "$HTTP_X_SB_TOKEN" = "$TOKEN" ] || json_err "401 Unauthorized" "token sai hoặc thiếu header X-SB-Token"

# ---- parse action ----
ACTION="$(echo "$QUERY_STRING" | sed -n 's/.*\(^\|&\)action=\([a-z_]*\).*/\2/p')"
BODY=""
[ "$REQUEST_METHOD" = "POST" ] && BODY="$(cat)"

# Build SSID JSON without exposing wifi_key or sock_pass.
# Reads the optional 11th column (mac_oui); older 10-column rows leave it empty.
ssids_json() {
  { grep -v '^[[:space:]]*#' "$CONF" 2>/dev/null | grep '|' | \
    while IFS='|' read -r name band idx key host port user pass iso web oui; do
      idx="$(echo "$idx" | tr -d ' ')"; [ -n "$idx" ] || continue
      iso="$(echo "$iso" | tr -d ' ')"; web="$(echo "$web" | tr -d ' ')"
      oui="$(echo "$oui" | tr -d ' \r')"
      jq -n --arg name "$name" --arg band "$band" --argjson idx "$idx" \
            --arg host "$host" --arg port "$(echo "$port"|tr -d ' ')" --arg user "$user" \
            --arg oui "$oui" \
            --argjson iso "$([ "$iso" = 1 ] && echo true || echo false)" \
            --argjson web "$([ "$web" = 1 ] && echo true || echo false)" \
        '{name:$name,band:$band,idx:$idx,host:$host,port:$port,hasAuth:($user!=""),isolate:$iso,webrtc:$web,mac_oui:$oui}'
    done; } | jq -s 'sort_by(.idx)'
}

case "$ACTION" in
  status)
    S="$(ssids_json)"; [ -n "$S" ] || S="[]"
    H="$(cat "$HEALTH_FILE" 2>/dev/null)"; [ -n "$H" ] || H='{}'
    applied="false"; [ -f "$SINGBOX_CONF" ] || [ -f /etc/sing-box/config.json ] && applied="true"
    running="false"; pgrep -f sing-box >/dev/null 2>&1 && running="true"
    json_ok "$(jq -n --argjson ssids "$S" --argjson health "$H" \
                     --argjson running "$running" --argjson applied "$applied" \
      '{ok:true, ssids:$ssids, health:$health, meta:{singbox_running:$running, applied:$applied}}')"
    ;;

  get_conf)
    hdr "200 OK" "text/plain"; cat "$CONF" 2>/dev/null; exit 0
    ;;

  save_conf)
    [ "$REQUEST_METHOD" = "POST" ] || json_err "405 Method Not Allowed" "cần POST"
    [ -n "$BODY" ] || json_err "400 Bad Request" "body rỗng"
    # Minimal structural validation before saving.
    bad="$(printf '%s\n' "$BODY" | grep -v '^[[:space:]]*#' | grep '|' | awk -F'|' 'NF<10{print NR}' | head -1)"
    [ -z "$bad" ] || json_err "400 Bad Request" "dòng $bad thiếu cột (cần 10 cột phân tách '|')"
    # Back up before writing desired config; the following apply uses --no-backup.
    OUT="$(cd "$SB_ROOT" && sh scripts/backup.sh pre-apply 2>&1)" || json_err "500 Internal Server Error" "backup trước apply thất bại"
    printf '%s\n' "$BODY" > "$CONF"
    json_ok "$(jq -n '{ok:true, saved:true}')"
    ;;

  apply)
    [ "$REQUEST_METHOD" = "POST" ] || json_err "405 Method Not Allowed" "cần POST"
    OUT="$(cd "$SB_ROOT" && sh scripts/apply.sh --no-backup 2>&1)"; RC=$?
    json_ok "$(jq -n --arg log "$OUT" --argjson rc "$RC" '{ok:($rc==0), rc:$rc, log:$log}')"
    ;;

  set_sock)
    [ "$REQUEST_METHOD" = "POST" ] || json_err "405 Method Not Allowed" "cần POST"
    idx="$(echo "$BODY" | jq -r '.idx // empty')"
    host="$(echo "$BODY" | jq -r '.host // empty')"
    port="$(echo "$BODY" | jq -r '.port // empty')"
    user="$(echo "$BODY" | jq -r '.user // ""')"
    pass="$(echo "$BODY" | jq -r '.pass // ""')"
    [ -n "$idx" ] && [ -n "$host" ] && [ -n "$port" ] || json_err "400 Bad Request" "thiếu idx/host/port"
    OUT="$(cd "$SB_ROOT" && sh scripts/set-sock.sh "$idx" "$host" "$port" "$user" "$pass" 2>&1)"; RC=$?
    json_ok "$(jq -n --arg log "$OUT" --argjson rc "$RC" '{ok:($rc==0), rc:$rc, log:$log}')"
    ;;

  rollback)
    [ "$REQUEST_METHOD" = "POST" ] || json_err "405 Method Not Allowed" "cần POST"
    name="$(echo "$BODY" | jq -r '.name // ""')"
    OUT="$(cd "$SB_ROOT" && SB_YES=1 sh scripts/rollback.sh "$name" 2>&1)"; RC=$?
    json_ok "$(jq -n --arg log "$OUT" --argjson rc "$RC" '{ok:($rc==0), rc:$rc, log:$log}')"
    ;;

  uninstall)
    [ "$REQUEST_METHOD" = "POST" ] || json_err "405 Method Not Allowed" "cần POST"
    OUT="$(cd "$SB_ROOT" && sh scripts/uninstall.sh 2>&1)"; RC=$?
    json_ok "$(jq -n --arg log "$OUT" --argjson rc "$RC" '{ok:($rc==0), rc:$rc, log:$log}')"
    ;;

  backups)
    B="$(ls -1dt "${BACKUP_DIR:-/root/sbproxy-backups}"/*/ 2>/dev/null | grep -v '/latest/$' | sed 's#.*/\([^/]*\)/$#\1#' | jq -R . | jq -s '.')"
    [ -n "$B" ] || B="[]"
    json_ok "$(jq -n --argjson b "$B" '{ok:true, backups:$b}')"
    ;;

  backup)
    [ "$REQUEST_METHOD" = "POST" ] || json_err "405 Method Not Allowed" "cần POST"
    label="$(echo "$BODY" | jq -r '.label // "ui"' 2>/dev/null)"
    OUT="$(cd "$SB_ROOT" && sh scripts/backup.sh "$label" 2>&1)"; RC=$?
    json_ok "$(jq -n --arg log "$OUT" --argjson rc "$RC" '{ok:($rc==0), rc:$rc, log:$log}')"
    ;;

  download_backup)
    # Download an off-device backup for recovery after reflash or brick.
    name="$(echo "$QUERY_STRING" | sed -n 's/.*[?&]name=\([A-Za-z0-9._-]*\).*/\1/p')"
    case "$name" in ""|*..*|*/*) json_err "400 Bad Request" "tên backup không hợp lệ";; esac
    dir="${BACKUP_DIR:-/root/sbproxy-backups}/$name"
    f="$dir/sysupgrade-backup.tar.gz"
    [ -f "$f" ] || f="$dir/etc-config.tar.gz"
    [ -f "$f" ] || json_err "404 Not Found" "không thấy file backup cho '$name'"
    printf 'Status: 200 OK\r\n'
    printf 'Content-Type: application/gzip\r\n'
    printf 'Content-Disposition: attachment; filename="sbproxy-%s.tar.gz"\r\n' "$name"
    printf 'Access-Control-Allow-Origin: *\r\n\r\n'
    cat "$f"
    exit 0
    ;;

  health_now)
    [ -x /usr/sbin/sbproxy-healthd ] && /usr/sbin/sbproxy-healthd --once >/dev/null 2>&1
    H="$(cat "$HEALTH_FILE" 2>/dev/null)"; [ -n "$H" ] || H='{}'
    json_ok "$(jq -n --argjson health "$H" '{ok:true, health:$health}')"
    ;;

  *)
    json_err "400 Bad Request" "action không hợp lệ: '$ACTION'"
    ;;
esac
