#!/bin/sh /etc/rc.common
# sbproxy — load nftables TPROXY rules and policy routing for sing-box.
# Installed by scripts/install-deps.sh and started after the firewall.
START=99
STOP=10

[ -f /etc/sbproxy.env ] && . /etc/sbproxy.env
NFT_FILE="${NFT_FILE:-/etc/sbproxy.nft}"
MARK="${TPROXY_MARK:-1}"
MASK="${TPROXY_MARK_MASK:-255}"
TABLE="${TPROXY_TABLE:-100}"
PRIORITY="${TPROXY_RULE_PRIORITY:-10000}"

start() {
  [ -f "$NFT_FILE" ] || { echo "sbproxy: thiếu $NFT_FILE"; return 1; }
  nft -f "$NFT_FILE" || { echo "sbproxy: nạp nft lỗi"; return 1; }
  # Policy routing delivers TPROXY-marked packets to the local socket.
  ip -4 rule del priority "$PRIORITY" 2>/dev/null || true
  ip -4 rule add priority "$PRIORITY" fwmark "$MARK/$MASK" table "$TABLE" || return 1
  ip -4 route replace local default dev lo table "$TABLE" || return 1
  echo "sbproxy: started"
}

stop() {
  nft delete table inet sbproxy 2>/dev/null
  ip -4 rule del priority "$PRIORITY" 2>/dev/null
  ip -4 route flush table $TABLE 2>/dev/null
  echo "sbproxy: stopped"
}

restart() { stop; start; }
